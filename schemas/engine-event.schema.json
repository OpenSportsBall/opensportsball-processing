{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensportsball.dev/schemas/engine-event.schema.json",
  "title": "Engine progress event",
  "description": "One line of the engine's stdout (JSON lines). Unknown event types and fields may appear in later versions; ignore them.",
  "type": "object",
  "required": [
    "event",
    "at"
  ],
  "properties": {
    "event": {
      "type": "string"
    },
    "at": {
      "type": "string",
      "description": "Local time with offset."
    }
  },
  "oneOf": [
    {
      "properties": {
        "event": {
          "const": "step"
        },
        "step": {
          "type": "string"
        },
        "status": {
          "enum": [
            "started",
            "done",
            "skipped"
          ]
        },
        "seconds": {
          "type": "number"
        },
        "log": {
          "type": "string"
        }
      },
      "required": [
        "step",
        "status"
      ]
    },
    {
      "properties": {
        "event": {
          "const": "questions"
        },
        "path": {
          "type": "string"
        },
        "pending": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "path",
        "pending"
      ]
    },
    {
      "properties": {
        "event": {
          "const": "answer"
        },
        "question": {
          "enum": [
            "cameras",
            "pitch",
            "kits"
          ]
        },
        "result": {
          "type": "string"
        }
      },
      "required": [
        "question",
        "result"
      ]
    },
    {
      "properties": {
        "event": {
          "const": "needs_answers"
        },
        "pending": {
          "type": "array"
        },
        "questions": {
          "type": "string"
        }
      },
      "required": [
        "pending"
      ]
    },
    {
      "properties": {
        "event": {
          "const": "progress"
        },
        "stage": {
          "type": "string"
        },
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "chunks": {
          "type": "integer"
        },
        "ballDone": {
          "type": "integer"
        },
        "followDone": {
          "type": "integer"
        },
        "elapsedS": {
          "type": "number"
        },
        "etaS": {
          "type": [
            "number",
            "null"
          ],
          "description": "From this run's pace; null until one chunk is done."
        }
      },
      "required": [
        "stage",
        "fraction"
      ]
    },
    {
      "properties": {
        "event": {
          "const": "done"
        },
        "output": {
          "type": "string"
        },
        "seconds": {
          "type": "number"
        },
        "ballAimShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share of the game so far the camera aimed at the ball."
        },
        "ballAimByChunk": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "The same per chunk the camera has followed, in percent."
        },
        "ballLow": {
          "type": "boolean",
          "description": "True when the models don't know this ball: the camera aimed at it in under 10% of the chunks after the first (the first alone can look fine). Absent while only one chunk of a running game is done. This game's video follows the play less closely; ball labels (label ball) teach later models."
        },
        "youtubeOutput": {
          "type": [
            "string",
            "null"
          ],
          "description": "The YouTube copy (game-youtube.mp4, 1440p) when the job asked for one and it is made."
        }
      },
      "required": [
        "output"
      ]
    },
    {
      "properties": {
        "event": {
          "const": "ball"
        },
        "chunksDone": {
          "type": "integer",
          "description": "Chunks the camera has followed so far."
        },
        "chunks": {
          "type": "integer"
        },
        "ballAimShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share of the game so far the camera aimed at the ball."
        },
        "ballAimByChunk": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "The same per chunk the camera has followed, in percent."
        },
        "ballLow": {
          "type": "boolean",
          "description": "True when the models don't know this ball: the camera aimed at it in under 10% of the chunks after the first (the first alone can look fine). Absent while only one chunk of a running game is done. This game's video follows the play less closely; ball labels (label ball) teach later models."
        }
      },
      "required": [
        "chunksDone",
        "ballAimShare",
        "ballAimByChunk"
      ],
      "description": "run: after each chunk the camera has followed, what it made of the ball so far; ballLow from the second chunk, hours before the game is done."
    },
    {
      "properties": {
        "event": {
          "const": "status"
        },
        "next": {
          "type": "string",
          "description": "The command to run next (or that the game is done)."
        },
        "ballAimShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share of the game so far the camera aimed at the ball."
        },
        "ballAimByChunk": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "The same per chunk the camera has followed, in percent."
        },
        "ballLow": {
          "type": "boolean",
          "description": "True when the models don't know this ball: the camera aimed at it in under 10% of the chunks after the first (the first alone can look fine). Absent while only one chunk of a running game is done. This game's video follows the play less closely; ball labels (label ball) teach later models."
        },
        "chunkDetails": {
          "type": "array",
          "description": "Each chunk of a game the engine has started: where its two stages stand. Empty before run.",
          "items": {
            "type": "object",
            "required": [
              "chunk",
              "startS",
              "seconds",
              "ball",
              "follow"
            ],
            "properties": {
              "chunk": {
                "type": "integer"
              },
              "startS": {
                "type": "number",
                "description": "Where the chunk starts, in seconds of the game video."
              },
              "seconds": {
                "type": "number"
              },
              "ball": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "waiting",
                      "running",
                      "done",
                      "failed"
                    ],
                    "description": "running is the last thing the engine wrote: if no engine is running, it was stopped there."
                  },
                  "startedAt": {
                    "type": "string"
                  },
                  "seconds": {
                    "type": "number",
                    "description": "How long the stage took."
                  },
                  "log": {
                    "type": "string",
                    "description": "The stage's log file."
                  }
                }
              },
              "follow": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "waiting",
                      "running",
                      "done",
                      "failed"
                    ],
                    "description": "running is the last thing the engine wrote: if no engine is running, it was stopped there."
                  },
                  "startedAt": {
                    "type": "string"
                  },
                  "seconds": {
                    "type": "number",
                    "description": "How long the stage took."
                  },
                  "log": {
                    "type": "string",
                    "description": "The stage's log file."
                  }
                }
              },
              "ballAimPct": {
                "type": "integer",
                "description": "Percent of the chunk the camera aimed at the ball."
              },
              "ballDetectedPct": {
                "type": "integer",
                "description": "Percent of the chunk's frames with a ball the judge accepted."
              }
            }
          }
        },
        "youtubeOutput": {
          "type": [
            "string",
            "null"
          ],
          "description": "The YouTube copy (game-youtube.mp4, 1440p) when the job asked for one and it is made."
        }
      }
    },
    {
      "properties": {
        "event": {
          "const": "error"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "log": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    {
      "properties": {
        "event": {
          "const": "stopped"
        },
        "message": {
          "type": "string"
        }
      }
    },
    {
      "properties": {
        "event": {
          "const": "labelset"
        },
        "set": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "ball",
            "moments"
          ]
        },
        "path": {
          "type": "string"
        },
        "items": {
          "type": "integer"
        }
      },
      "required": [
        "set",
        "path"
      ]
    },
    {
      "properties": {
        "event": {
          "const": "labels"
        },
        "set": {
          "type": "string"
        },
        "labelled": {
          "type": "integer"
        },
        "items": {
          "type": "integer"
        }
      },
      "required": [
        "set",
        "labelled"
      ]
    },
    {
      "properties": {
        "event": {
          "const": "share"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "type": "integer"
        },
        "reason": {
          "type": "string",
          "description": "Why nothing was written, when path is null."
        }
      },
      "required": [
        "name"
      ]
    }
  ]
}
