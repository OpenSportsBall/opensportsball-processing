{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensportsball.dev/schemas/engine-answers.schema.json",
  "title": "Answers to the engine's questions",
  "description": "The user's answers to engine-questions.schema.json, given to `prepare` or `run` with --answers. Each answer names the question's round; an answer to an older round is ignored, so the whole file can simply be rewritten and passed again.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "pitch": {
      "type": "object",
      "required": [
        "round"
      ],
      "additionalProperties": false,
      "description": "Either approve the drawn pitch, or give the keypoints; the engine refits and asks again in the next round.",
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "approve": {
          "const": true
        },
        "points": {
          "type": "object",
          "description": "Keypoints by name (the names in the question's points). A point the user moved has yaw and pitch; one left where the fit drew it, fromFit; one they couldn't see, skipped.",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "yaw",
                  "pitch"
                ],
                "additionalProperties": false,
                "properties": {
                  "yaw": {
                    "type": "number"
                  },
                  "pitch": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "fromFit"
                ],
                "additionalProperties": false,
                "properties": {
                  "fromFit": {
                    "const": true
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "skipped"
                ],
                "additionalProperties": false,
                "properties": {
                  "skipped": {
                    "const": true
                  }
                }
              }
            ]
          }
        },
        "share": {
          "type": "boolean",
          "description": "Whether the user agreed to share this pitch map and these points to improve pitch detection (the app's switch, on by default). The engine records it; the app sends."
        }
      },
      "oneOf": [
        {
          "required": [
            "approve"
          ]
        },
        {
          "required": [
            "points"
          ]
        }
      ]
    },
    "cameras": {
      "type": "object",
      "required": [
        "round",
        "leftPhone"
      ],
      "additionalProperties": false,
      "description": "Which phone is on the left: the question's panorama that shows the pitch in one piece.",
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "leftPhone": {
          "enum": [
            "main",
            "secondary"
          ]
        }
      }
    }
  }
}
